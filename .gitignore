# ── DỮ LIỆU (TUYỆT ĐỐI KHÔNG PUSH LÊN GITHUB) ──
data/raw/
data/processed/

# ── KẾT QUẢ CHẠY (weights nặng, không cần thiết push) ──
result/checkpoints/
result/plots/
result/logs/

# ── Python cache ──
__pycache__/
*.py[codz]
*$py.class
*.so

# ── Distribution / packaging ──
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Jupyter Notebook ──
.ipynb_checkpoints
*.ipynb

# ── Môi trường ảo ──
.env
.venv
env/
venv/
ENV/

# ── IDE ──
.vscode/
.idea/
*.suo
*.user

# ── OS ──
.DS_Store
Thumbs.db
# Bỏ qua toàn bộ Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Bỏ qua kết quả chạy (Weights, Logs, Ảnh)
result/checkpoints/*
result/logs/*
result/plots/*
!result/checkpoints/.gitkeep
!result/logs/.gitkeep
!result/plots/.gitkeep

